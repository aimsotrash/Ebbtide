# ───────────────────────────────────────────────────────────────────────
# Engram frontend environment
# Copy to `.env.local`. Only these three vars are read by the app.
# All Vite envs MUST be prefixed with VITE_ to be exposed to the browser.
# ───────────────────────────────────────────────────────────────────────

# Backend base URL. Local dev: http://localhost:8001.
# Production: your deployed FastAPI URL (e.g. https://your-backend.hf.space).
VITE_API_BASE_URL=http://localhost:8001

# When true, all API calls return bundled mock JSON instead of hitting the
# backend. Useful for a UI-only demo or running without the Python stack.
VITE_USE_MOCKS=false

# How often the dashboard polls /api/discovery in the background, in ms.
# Default 30s. Set to a very large number to effectively disable.
VITE_DISCOVERY_POLL_MS=30000
