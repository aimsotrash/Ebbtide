# ───────────────────────────────────────────────────────────────────────
# Dory.md backend environment
# Copy this file to `.env` and fill in the values your deployment needs.
# Every variable here is read via `os.getenv(...)` somewhere in the code.
# ───────────────────────────────────────────────────────────────────────

# ── Required ───────────────────────────────────────────────────────────

# DORY_ENV selects the runtime profile: "dev" (default) or anything else
# ("production", "staging", ...). It controls three security behaviours:
#   - JWT secret: dev generates a random ephemeral secret if JWT_SECRET is
#     unset; any non-dev value REQUIRES JWT_SECRET or the app refuses to boot.
#   - Demo account: the demo@dory.md user is only seeded in dev.
#   - Rate limiting: inert in dev, on by default otherwise.
# SET THIS to a non-dev value (e.g. "production") in every real deployment.
DORY_ENV=dev

# Signing secret for JWT access/refresh tokens. REQUIRED whenever DORY_ENV is
# not "dev" — the app fails fast at startup if it is missing. In dev, leaving it
# blank makes the app generate a random per-process secret (no hardcoded
# fallback; dev tokens simply don't survive a restart). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ── LLM provider (optional but recommended) ────────────────────────────
# Without an API key the LLM-driven features (quiz generation, category
# classification, /api/ai/summarize|expand|optimize) degrade gracefully:
# quizzes fall back to a hardcoded bank, classification stays "Other", etc.

# Provider: groq | openai | anthropic | ollama (any OpenAI-compatible).
LLM_PROVIDER=groq
LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Only the key matching LLM_PROVIDER is consulted.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=          # only if LLM_PROVIDER=openai

# Ollama (local): only used if LLM_PROVIDER=ollama. Defaults to the standard
# port; uncomment to override.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ── CORS (REQUIRED in production) ──────────────────────────────────────
# Browser origins allowed to call this API. There is NO permissive default
# outside dev: if neither variable below is set and DORY_ENV != dev, all
# cross-origin browser requests are blocked.
#
# Preferred: an explicit, comma-separated allow-list of EXACT origins.
# CORS_ALLOW_ORIGINS=https://app.dory.md,https://dory.vercel.app
#
# Advanced/alternative: a single regex (use only if you understand it; avoid
# broad matches like .*\.vercel\.app which would let any preview deploy in).
# CORS_ORIGIN_REGEX=https://app\.dory\.md|https://[\w-]+\.your-own-domain\.com
#
# In dev (DORY_ENV=dev) neither is required: localhost + RFC-1918 LAN ranges
# are allowed automatically (never public hosts).

# ── Observability & limits ─────────────────────────────────────────────
# Log verbosity: DEBUG | INFO | WARNING | ERROR (default INFO).
# LOG_LEVEL=INFO
# Requests/min/client-IP on auth + AI endpoints (default 60; 0 disables).
# Inert when DORY_ENV=dev. Production gets protection by default.
# DORY_RATE_LIMIT_PER_MIN=60

# ── Test / advanced (rarely used) ──────────────────────────────────────

# Override the SQLite path. Tests set this to a temp file; you almost
# never set it manually.
# DORY_DB_PATH=/path/to/dory.db

# Override the ChromaDB vector-store directory (defaults to backend/data/chroma).
# DORY_CHROMA_PATH=/path/to/chroma

# Skip the SentenceTransformer warm-up at startup. Faster boot, slower
# first ingest/search call (model loads on demand).
# DORY_SKIP_WARMUP=1
